+static void
+sweet_virtio_input_init_device(void)
+{
+	if (!sv.inp_regs) {
+		return;
+	}
+	if (virtio_setup_queue(sv.inp_regs, sv.inp_version, DMA_INP_VRING,
+	    DMA_INP_USED, &sv.inp_qsize) != 0) {
+		sv.inp_regs = 0;
+		return;
+	}
+	struct vring_desc *desc = (struct vring_desc *)(sv.dma + DMA_INP_VRING);
+	struct vring_avail *avail = (struct vring_avail *)(sv.dma + DMA_INP_VRING +
+	    sv.inp_qsize * sizeof(struct vring_desc));
+	for (uint32_t i = 0; i < sv.inp_qsize; i++) {
+		desc[i].addr = sv.dma_pa + DMA_INP_BUFS + i * sizeof(struct virtio_input_event);
+		desc[i].len = sizeof(struct virtio_input_event);
+		desc[i].flags = VRING_DESC_F_WRITE;
+		desc[i].next = 0;
+		avail->ring[i] = (uint16_t)i;
+	}
+	avail->idx = (uint16_t)sv.inp_qsize;
+	dma_sync(DMA_INP_VRING, 0x3000);
+	__builtin_arm_dsb(0xf);
+	mmio_wr(sv.inp_regs, VIRTIO_MMIO_QUEUE_NOTIFY, 0);
+	printf("SWEET VIRTIO: virtio-input ready (qsize %u)\n", sv.inp_qsize);
+}
+
+static void
+sweet_virtio_input_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	volatile struct sweet_input_mailbox *mbox =
+	    (volatile struct sweet_input_mailbox *)sv.mbox;
+	int cur_x = 540, cur_y = 1200, cur_down = 0, cur_slot = 0;
+	bool dirty_touch = false;
+	uint8_t pkt[8];
+	uint32_t pkt_len = 0;
+
+	for (;;) {
+		if (sv.uart != 0) {
+			while ((mmio_rd(sv.uart, 0x18U) & 0x10U) == 0) {
+				uint8_t b = (uint8_t)(mmio_rd(sv.uart, 0x00U) & 0xffU);
+				if (pkt_len == 0 && b != 0xa5U) {
+					continue;
+				}
+				pkt[pkt_len++] = b;
+				if (pkt_len == 8U) {
+					pkt_len = 0;
+					uint16_t x = (uint16_t)pkt[4] | ((uint16_t)pkt[5] << 8);
+					uint16_t y = (uint16_t)pkt[6] | ((uint16_t)pkt[7] << 8);
+					if (pkt[1] == SWEET_INPUT_EV_TOUCH) {
+						sweet_hid_touch((int)pkt[2], (int)pkt[3], (int)x, (int)y);
+					} else if (pkt[1] == SWEET_INPUT_EV_KEY) {
+						sweet_hid_key((int)pkt[2], (int)pkt[3]);
+					}
+				}
+			}
+		}
+
+		if (mbox != NULL && mmio_rd(sv.mbox, 0) == SWEET_INPUT_MAGIC) {
+			uint32_t w = mmio_rd(sv.mbox, 4);
+			uint32_t r = mmio_rd(sv.mbox, 8);
+			if (w - r > SWEET_INPUT_RING_LEN) {
+				r = w - SWEET_INPUT_RING_LEN;
+			}
+			while (r != w) {
+				uint32_t off = 0x10U + (r % SWEET_INPUT_RING_LEN) * 16U;
+				uint32_t w0 = mmio_rd(sv.mbox, off + 0);
+				int32_t down = (int32_t)mmio_rd(sv.mbox, off + 4);
+				int32_t x = (int32_t)mmio_rd(sv.mbox, off + 8);
+				int32_t y = (int32_t)mmio_rd(sv.mbox, off + 12);
+				uint16_t type = (uint16_t)(w0 & 0xffffU);
+				uint16_t id = (uint16_t)(w0 >> 16);
+				r++;
+				mmio_wr(sv.mbox, 8, r);
+				if (type == SWEET_INPUT_EV_TOUCH) {
+					sweet_hid_touch((int)id, down, x, y);
+				} else if (type == SWEET_INPUT_EV_KEY) {
+					sweet_hid_key((int)id, down);
+				}
+			}
+		}
+
+		if (sv.inp_regs != 0) {
+			struct vring_avail *avail = (struct vring_avail *)(sv.dma + DMA_INP_VRING +
+			    sv.inp_qsize * sizeof(struct vring_desc));
+			volatile struct vring_used *used =
+			    (volatile struct vring_used *)(sv.dma + DMA_INP_USED);
+			struct virtio_input_event *events =
+			    (struct virtio_input_event *)(sv.dma + DMA_INP_BUFS);
+			dma_sync(DMA_INP_USED, sizeof(struct vring_used));
+			bool refilled = false;
+			while (used->idx != sv.inp_last_used) {
+				uint32_t id = used->ring[sv.inp_last_used % sv.inp_qsize].id % sv.inp_qsize;
+				dma_sync(DMA_INP_BUFS + id * (uint32_t)sizeof(*events), sizeof(*events));
+				struct virtio_input_event ev = events[id];
+				if (ev.type == 0x03) { /* EV_ABS */
+					if (ev.code == 0x00 || ev.code == 0x35) {
+						cur_x = (int)((ev.value * 1080U) / 32768U);
+						dirty_touch = true;
+					} else if (ev.code == 0x01 || ev.code == 0x36) {
+						cur_y = (int)((ev.value * 2400U) / 32768U);
+						dirty_touch = true;
+					} else if (ev.code == 0x2f && ev.value < 10U) {
+						cur_slot = (int)ev.value;
+					} else if (ev.code == 0x39) {
+						cur_down = (ev.value != 0xffffffffU) ? 1 : 0;
+						dirty_touch = true;
+					}
+				} else if (ev.type == 0x01) { /* EV_KEY */
+					int down = (ev.value != 0) ? 1 : 0;
+					if (ev.code == 0x14a || ev.code == 0x110) {
+						cur_down = down;
+						dirty_touch = true;
+					} else if (ev.code == 116 || ev.code == 1) {
+						sweet_hid_key(0, down);
+					} else if (ev.code == 115 || ev.code == 103) {
+						sweet_hid_key(1, down);
+					} else if (ev.code == 114 || ev.code == 108) {
+						sweet_hid_key(2, down);
+					} else if (ev.code == 172 || ev.code == 28 || ev.code == 35) {
+						sweet_hid_key(3, down);
+					}
+				} else if (ev.type == 0x00 && ev.code == 0x00 && dirty_touch) { /* SYN_REPORT */
+					sweet_hid_touch(cur_slot, cur_down, cur_x, cur_y);
+					dirty_touch = false;
+				}
+				avail->ring[avail->idx % sv.inp_qsize] = (uint16_t)id;
+				avail->idx++;
+				sv.inp_last_used++;
+				refilled = true;
+			}
+			if (refilled) {
+				uint32_t isr = mmio_rd(sv.inp_regs, VIRTIO_MMIO_INTERRUPT_STATUS);
+				if (isr) {
+					mmio_wr(sv.inp_regs, VIRTIO_MMIO_INTERRUPT_ACK, isr);
+				}
+				dma_sync(DMA_INP_VRING, 0x1000);
+				__builtin_arm_dsb(0xf);
+				mmio_wr(sv.inp_regs, VIRTIO_MMIO_QUEUE_NOTIFY, 0);
+			}
+		}
+
+		uint64_t deadline;
+		clock_interval_to_deadline(10, NSEC_PER_MSEC, &deadline);
+		(void)assert_wait_deadline(&sweet_virtio_input_chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
+static int
+sweet_virtio_init(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	uintptr_t const *mbox_reg = NULL;
+	unsigned int size = 0;
+	uint64_t mmio_pa = VIRTIO_MMIO_BASE_PA, mmio_sz = VIRTIO_MMIO_TOTAL_SIZE;
+	uint64_t mbox_pa = SWEET_INPUT_PA, mbox_sz = SWEET_INPUT_SIZE;
+	char want[64] = "userdata";
+	uint32_t rw = 1, qemu = 0;
+
+	if (SecureDTLookupEntry(NULL, "/sweet-virt", &node) == kSuccess) {
+		if (SecureDTGetProperty(node, "reg", (void const **)&reg, &size) == kSuccess &&
+		    size >= 2 * sizeof(uintptr_t)) {
+			mmio_pa = reg[0];
+			mmio_sz = reg[1];
+		}
+		if (SecureDTGetProperty(node, "input-mailbox", (void const **)&mbox_reg, &size) == kSuccess &&
+		    size >= 2 * sizeof(uintptr_t)) {
+			mbox_pa = mbox_reg[0];
+			mbox_sz = mbox_reg[1];
+		}
+	} else if (SecureDTLookupEntry(NULL, "/chosen", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "qemu-virt", (void const **)&reg, &size) != kSuccess) {
+		if (!PE_parse_boot_argn("qemu", &qemu, sizeof(qemu)) || !qemu) {
+			return ENXIO;
+		}
+	}
+
+	PE_parse_boot_argn("ufsroot", want, sizeof(want));
+	PE_parse_boot_argn("ufsrw", &rw, sizeof(rw));
+
+	sv.mmio_base = ml_io_map((vm_offset_t)mmio_pa, (vm_size_t)mmio_sz);
+	if (!sv.mmio_base) {
+		return ENOMEM;
+	}
+	if (kmem_alloc_contig(kernel_map, &sv.dma, DMA_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET VIRTIO: no contiguous DMA memory\n");
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)sv.dma);
+	if (!pn) {
+		return ENOMEM;
+	}
+	sv.dma_pa = ptoa_64(pn);
+	sv.secsize = DEV_BSIZE;
+
+	for (uint32_t slot = 0; slot < VIRTIO_MMIO_SLOTS; slot++) {
+		vm_offset_t base = sv.mmio_base + slot * VIRTIO_MMIO_SLOT_SIZE;
+		uint32_t magic = mmio_rd(base, VIRTIO_MMIO_MAGIC_VALUE);
+		uint32_t ver = mmio_rd(base, VIRTIO_MMIO_VERSION);
+		uint32_t devid = mmio_rd(base, VIRTIO_MMIO_DEVICE_ID);
+		if (magic != VIRTIO_MAGIC || (ver != 1 && ver != 2) || devid == 0) {
+			continue;
+		}
+		printf("SWEET VIRTIO: slot %u: version %u device_id %u\n", slot, ver, devid);
+		if (devid == VIRTIO_DEV_BLK && sv.blk_regs == 0) {
+			sv.blk_regs = base;
+			sv.blk_version = ver;
+		} else if (devid == VIRTIO_DEV_INPUT && sv.inp_regs == 0) {
+			sv.inp_regs = base;
+			sv.inp_version = ver;
+		}
+	}
+
+	if (sv.blk_regs == 0) {
+		printf("SWEET VIRTIO: no virtio-blk device found\n");
+		return ENXIO;
+	}
+
+	lck_mtx_lock(&sweet_virtio_lock);
+	int error = virtio_setup_queue(sv.blk_regs, sv.blk_version, DMA_BLK_VRING,
+	    DMA_BLK_USED, &sv.blk_qsize);
+	if (!error) {
+		uint64_t cap_lo = mmio_rd(sv.blk_regs, VIRTIO_MMIO_CONFIG + 0);
+		uint64_t cap_hi = mmio_rd(sv.blk_regs, VIRTIO_MMIO_CONFIG + 4);
+		sv.capacity_secs = cap_lo | (cap_hi << 32);
+		error = virtio_find_volume(want);
+	}
+	lck_mtx_unlock(&sweet_virtio_lock);
+	if (error) {
+		return error;
+	}
+
+	sv.bmajor = bdevsw_add(-1, &sweet_virtio_bdevsw);
+	if (sv.bmajor < 0) {
+		return ENXIO;
+	}
+	sv.cmajor = cdevsw_add_with_bdev(-1, &sweet_virtio_cdevsw, sv.bmajor);
+	if (sv.cmajor < 0) {
+		return ENXIO;
+	}
+	sv.bdev = makedev(sv.bmajor, 0);
+	devfs_make_node(sv.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "ufsroot0");
+	devfs_make_node(makedev(sv.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "rufsroot0");
+	sv.writable = (rw != 0);
+	sv.ready = true;
+	printf("SWEET VIRTIO: ufsroot0 ready: first_sec 0x%llx, %llu MiB, %s, DMA at 0x%llx\n",
+	    sv.first_sec, (sv.nsecs * VIRTIO_SECTOR) >> 20,
+	    sv.writable ? "read-write" : "read-only", sv.dma_pa);
+
+	sv.uart = ml_io_map(0x09000000ULL, 0x1000ULL);
+	if (sv.uart) {
+		mmio_wr(sv.uart, 0x2cU, 0x10U);
+		mmio_wr(sv.uart, 0x30U, 0x301U);
+	}
+	sv.mbox = ml_io_map((vm_offset_t)mbox_pa, (vm_size_t)mbox_sz);
+	if (sv.mbox) {
+		if (mmio_rd(sv.mbox, 0) != SWEET_INPUT_MAGIC) {
+			for (uint32_t off = 0; off < sizeof(struct sweet_input_mailbox); off += 4) {
+				mmio_wr(sv.mbox, off, 0);
+			}
+			mmio_wr(sv.mbox, 0, SWEET_INPUT_MAGIC);
+		}
+		printf("SWEET VIRTIO: input mailbox at 0x%llx ready (magic 0x%08x)\n",
+		    mbox_pa, mmio_rd(sv.mbox, 0));
+	}
+	sweet_virtio_input_init_device();
+	thread_t thread;
+	if (kernel_thread_start(sweet_virtio_input_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	sweet_sample_start();
+	return 0;
+}
+
+int sweet_virtio_rootdev(dev_t *dev);
+
+int
+sweet_virtio_rootdev(dev_t *dev)
+{
+	if (!sv.ready) {
+		int error = sweet_virtio_init();
+		if (error) {
+			return error;
+		}
+	}
+	*dev = sv.bdev;
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */

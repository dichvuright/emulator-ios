+/*
+ * SWEET QEMU virt root block device (virtio-blk) and live input bridge
+ * (shared-memory input mailbox + virtio-input).
+ *
+ * When booting on QEMU's virt machine (tools/mkadt.py --qemu), there is no
+ * Qualcomm UFS host (/sweet-ufs is absent). Instead, /sweet-virt describes
+ * the 32 virtio-mmio transports at 0x0a000000 and the shared-memory input
+ * mailbox at 0x9d600000.
+ *
+ * This driver probes virtio-mmio for a block device (DeviceID 2), supports
+ * both legacy (v1) and modern (v2) virtio-mmio transports in polled mode,
+ * detects either a raw HFS+/HFSX volume at LBA 0 or a GPT partition, and
+ * exposes it as ufsroot0 / rufsroot0 for rd=ufsroot0. It also starts a
+ * 10 ms polling thread that forwards touch and button events from the
+ * input mailbox (and any virtio-input transport) to SweetHID.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+extern void sweet_sample_start(void);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+extern void sweet_hid_key(int key, int down);
+
+/* QEMU virt virtio-mmio transport layout: 32 slots * 0x200 at 0x0a000000 */
+#define VIRTIO_MMIO_BASE_PA             0x0a000000ULL
+#define VIRTIO_MMIO_TOTAL_SIZE          0x4000ULL
+#define VIRTIO_MMIO_SLOT_SIZE           0x200U
+#define VIRTIO_MMIO_SLOTS               32U
+
+#define VIRTIO_MMIO_MAGIC_VALUE         0x000U
+#define VIRTIO_MMIO_VERSION             0x004U
+#define VIRTIO_MMIO_DEVICE_ID           0x008U
+#define VIRTIO_MMIO_VENDOR_ID           0x00cU
+#define VIRTIO_MMIO_DEVICE_FEATURES     0x010U
+#define VIRTIO_MMIO_DEVICE_FEATURES_SEL 0x014U
+#define VIRTIO_MMIO_DRIVER_FEATURES     0x020U
+#define VIRTIO_MMIO_DRIVER_FEATURES_SEL 0x024U
+#define VIRTIO_MMIO_GUEST_PAGE_SIZE     0x028U  /* v1 only */
+#define VIRTIO_MMIO_QUEUE_SEL           0x030U
+#define VIRTIO_MMIO_QUEUE_NUM_MAX       0x034U
+#define VIRTIO_MMIO_QUEUE_NUM           0x038U
+#define VIRTIO_MMIO_QUEUE_ALIGN         0x03cU  /* v1 only */
+#define VIRTIO_MMIO_QUEUE_PFN           0x040U  /* v1 only */
+#define VIRTIO_MMIO_QUEUE_READY         0x044U  /* v2 only */
+#define VIRTIO_MMIO_QUEUE_NOTIFY        0x050U
+#define VIRTIO_MMIO_INTERRUPT_STATUS    0x060U
+#define VIRTIO_MMIO_INTERRUPT_ACK       0x064U
+#define VIRTIO_MMIO_STATUS              0x070U
+#define VIRTIO_MMIO_QUEUE_DESC_LOW      0x080U  /* v2 only */
+#define VIRTIO_MMIO_QUEUE_DESC_HIGH     0x084U  /* v2 only */
+#define VIRTIO_MMIO_QUEUE_AVAIL_LOW     0x090U  /* v2 only */
+#define VIRTIO_MMIO_QUEUE_AVAIL_HIGH    0x094U  /* v2 only */
+#define VIRTIO_MMIO_QUEUE_USED_LOW      0x0a0U  /* v2 only */
+#define VIRTIO_MMIO_QUEUE_USED_HIGH     0x0a4U  /* v2 only */
+#define VIRTIO_MMIO_CONFIG              0x100U
+
+#define VIRTIO_MAGIC                    0x74726976U     /* 'virt' */
+#define VIRTIO_DEV_BLK                  2U
+#define VIRTIO_DEV_INPUT                18U
+
+#define VIRTIO_STATUS_ACKNOWLEDGE       1U
+#define VIRTIO_STATUS_DRIVER            2U
+#define VIRTIO_STATUS_DRIVER_OK         4U
+#define VIRTIO_STATUS_FEATURES_OK       8U
+#define VIRTIO_STATUS_FAILED            128U
+
+#define VRING_DESC_F_NEXT               1U
+#define VRING_DESC_F_WRITE              2U
+
+#define VIRTIO_BLK_T_IN                 0U
+#define VIRTIO_BLK_T_OUT                1U
+#define VIRTIO_BLK_T_FLUSH              4U
+#define VIRTIO_BLK_S_OK                 0U
+
+#define VIRTIO_SECTOR                   512U
+#define VIRTIO_PHYS_BLOCK               4096U
+#define VRING_SIZE                      16U
+#define VRING_ALIGN                     4096U
+#define BOUNCE_SIZE                     (1U << 20)
+#define CMD_TIMEOUT_NS                  (5ULL * NSEC_PER_SEC)
+
+/* Contiguous DMA layout:
+ *   0x0000..0x1fff: blk vring (desc + avail at +0x0000, used at +0x1000)
+ *   0x2000..0x2fff: blk req_hdr + status
+ *   0x3000..0x4fff: optional virtio-input vring + event buffers
+ *   0x8000..      : 1 MiB bounce buffer
+ */
+#define DMA_BLK_VRING                   0x0000U
+#define DMA_BLK_USED                    0x1000U
+#define DMA_BLK_REQ                     0x2000U
+#define DMA_BLK_STATUS                  0x2010U
+#define DMA_INP_VRING                   0x3000U
+#define DMA_INP_USED                    0x4000U
+#define DMA_INP_BUFS                    0x5000U
+#define DMA_BOUNCE                      0x8000U
+#define DMA_SIZE                        (DMA_BOUNCE + BOUNCE_SIZE)
+
+struct vring_desc {
+	uint64_t addr;
+	uint32_t len;
+	uint16_t flags;
+	uint16_t next;
+};
+
+struct vring_avail {
+	uint16_t flags;
+	uint16_t idx;
+	uint16_t ring[VRING_SIZE];
+	uint16_t used_event;
+};
+
+struct vring_used_elem {
+	uint32_t id;
+	uint32_t len;
+};
+
+struct vring_used {
+	uint16_t flags;
+	uint16_t idx;
+	struct vring_used_elem ring[VRING_SIZE];
+	uint16_t avail_event;
+};
+
+struct virtio_blk_req_hdr {
+	uint32_t type;
+	uint32_t ioprio;
+	uint64_t sector;
+};
+
+struct virtio_input_event {
+	uint16_t type;
+	uint16_t code;
+	uint32_t value;
+};
+
+/* Shared-memory input mailbox at 0x9d600000 (host/QMP -> guest HID). */
+#define SWEET_INPUT_PA                  0x9d600000ULL
+#define SWEET_INPUT_SIZE                0x4000ULL
+#define SWEET_INPUT_MAGIC               0x5357494eU     /* 'SWIN' */
+#define SWEET_INPUT_RING_LEN            64U
+#define SWEET_INPUT_EV_TOUCH            1U
+#define SWEET_INPUT_EV_KEY              2U
+
+struct sweet_input_event {
+	uint16_t type;          /* 1 = touch, 2 = key */
+	uint16_t id;            /* finger 0..9 or key 0..3 */
+	int32_t  down;          /* 0 = up, 1 = down */
+	int32_t  x;             /* 0..1079 for touch */
+	int32_t  y;             /* 0..2399 for touch */
+};
+
+struct sweet_input_mailbox {
+	uint32_t magic;         /* 0x00: 0x5357494e ('SWIN') */
+	uint32_t write_idx;     /* 0x04: incremented by host */
+	uint32_t read_idx;      /* 0x08: updated by guest */
+	uint32_t flags;         /* 0x0c: status flags */
+	struct sweet_input_event events[SWEET_INPUT_RING_LEN]; /* 0x10 */
+};
+
+static struct {
+	vm_offset_t mmio_base;
+	vm_offset_t blk_regs;
+	vm_offset_t inp_regs;
+	vm_offset_t mbox;
+	vm_offset_t uart;
+	vm_offset_t dma;
+	uint64_t dma_pa;
+	uint32_t blk_version;
+	uint32_t blk_qsize;
+	uint16_t blk_last_used;
+	uint32_t inp_version;
+	uint32_t inp_qsize;
+	uint16_t inp_last_used;
+	uint64_t capacity_secs;
+	uint64_t first_sec, nsecs;
+	uint32_t secsize;
+	bool writable;
+	int bmajor, cmajor;
+	dev_t bdev;
+	bool ready;
+} sv;
+
+static LCK_GRP_DECLARE(sweet_virtio_grp, "sweet_virtio");
+static LCK_MTX_DECLARE(sweet_virtio_lock, &sweet_virtio_grp);
+static int sweet_virtio_input_chan;
+
+static inline uint32_t
+mmio_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+mmio_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+dma_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(sv.dma_pa + off), len, TRUE);
+}
+
+static int
+virtio_setup_queue(vm_offset_t regs, uint32_t version, uint32_t vring_off,
+    uint32_t used_off, uint32_t *out_qsize)
+{
+	mmio_wr(regs, VIRTIO_MMIO_STATUS, 0);
+	mmio_wr(regs, VIRTIO_MMIO_STATUS, VIRTIO_STATUS_ACKNOWLEDGE);
+	mmio_wr(regs, VIRTIO_MMIO_STATUS,
+	    VIRTIO_STATUS_ACKNOWLEDGE | VIRTIO_STATUS_DRIVER);
+
+	mmio_wr(regs, VIRTIO_MMIO_DEVICE_FEATURES_SEL, 0);
+	(void)mmio_rd(regs, VIRTIO_MMIO_DEVICE_FEATURES);
+	mmio_wr(regs, VIRTIO_MMIO_DRIVER_FEATURES_SEL, 0);
+	mmio_wr(regs, VIRTIO_MMIO_DRIVER_FEATURES, 0);
+
+	if (version >= 2) {
+		mmio_wr(regs, VIRTIO_MMIO_DEVICE_FEATURES_SEL, 1);
+		uint32_t f1 = mmio_rd(regs, VIRTIO_MMIO_DEVICE_FEATURES);
+		mmio_wr(regs, VIRTIO_MMIO_DRIVER_FEATURES_SEL, 1);
+		mmio_wr(regs, VIRTIO_MMIO_DRIVER_FEATURES, f1 & 1U);
+		mmio_wr(regs, VIRTIO_MMIO_STATUS,
+		    VIRTIO_STATUS_ACKNOWLEDGE | VIRTIO_STATUS_DRIVER | VIRTIO_STATUS_FEATURES_OK);
+		if (!(mmio_rd(regs, VIRTIO_MMIO_STATUS) & VIRTIO_STATUS_FEATURES_OK)) {
+			return ENXIO;
+		}
+	} else {
+		mmio_wr(regs, VIRTIO_MMIO_GUEST_PAGE_SIZE, VRING_ALIGN);
+	}
+
+	mmio_wr(regs, VIRTIO_MMIO_QUEUE_SEL, 0);
+	uint32_t max_q = mmio_rd(regs, VIRTIO_MMIO_QUEUE_NUM_MAX);
+	if (max_q < 4) {
+		return ENXIO;
+	}
+	uint32_t qsize = MIN(VRING_SIZE, max_q);
+	mmio_wr(regs, VIRTIO_MMIO_QUEUE_NUM, qsize);
+
+	uint64_t desc_pa = sv.dma_pa + vring_off;
+	uint64_t avail_pa = desc_pa + (uint64_t)qsize * sizeof(struct vring_desc);
+	uint64_t used_pa = sv.dma_pa + used_off;
+
+	if (version == 1) {
+		mmio_wr(regs, VIRTIO_MMIO_QUEUE_ALIGN, VRING_ALIGN);
+		mmio_wr(regs, VIRTIO_MMIO_QUEUE_PFN, (uint32_t)(desc_pa >> 12));
+	} else {
+		mmio_wr(regs, VIRTIO_MMIO_QUEUE_DESC_LOW, (uint32_t)desc_pa);
+		mmio_wr(regs, VIRTIO_MMIO_QUEUE_DESC_HIGH, (uint32_t)(desc_pa >> 32));
+		mmio_wr(regs, VIRTIO_MMIO_QUEUE_AVAIL_LOW, (uint32_t)avail_pa);
+		mmio_wr(regs, VIRTIO_MMIO_QUEUE_AVAIL_HIGH, (uint32_t)(avail_pa >> 32));
+		mmio_wr(regs, VIRTIO_MMIO_QUEUE_USED_LOW, (uint32_t)used_pa);
+		mmio_wr(regs, VIRTIO_MMIO_QUEUE_USED_HIGH, (uint32_t)(used_pa >> 32));
+		mmio_wr(regs, VIRTIO_MMIO_QUEUE_READY, 1);
+	}
+
+	uint32_t st = mmio_rd(regs, VIRTIO_MMIO_STATUS);
+	mmio_wr(regs, VIRTIO_MMIO_STATUS, st | VIRTIO_STATUS_DRIVER_OK);
+	*out_qsize = qsize;
+	return 0;
+}
+
+static int
+virtio_blk_cmd(uint32_t type, uint64_t sector, uint32_t len, bool write)
+{
+	struct vring_desc *desc = (struct vring_desc *)(sv.dma + DMA_BLK_VRING);
+	struct vring_avail *avail = (struct vring_avail *)(sv.dma + DMA_BLK_VRING +
+	    sv.blk_qsize * sizeof(struct vring_desc));
+	volatile struct vring_used *used = (volatile struct vring_used *)(sv.dma + DMA_BLK_USED);
+	struct virtio_blk_req_hdr *hdr = (struct virtio_blk_req_hdr *)(sv.dma + DMA_BLK_REQ);
+	volatile uint8_t *status = (volatile uint8_t *)(sv.dma + DMA_BLK_STATUS);
+
+	hdr->type = type;
+	hdr->ioprio = 0;
+	hdr->sector = sector;
+	*status = 0xff;
+
+	desc[0].addr = sv.dma_pa + DMA_BLK_REQ;
+	desc[0].len = sizeof(*hdr);
+	desc[0].flags = VRING_DESC_F_NEXT;
+	desc[0].next = 1;
+
+	if (len > 0) {
+		desc[1].addr = sv.dma_pa + DMA_BOUNCE;
+		desc[1].len = len;
+		desc[1].flags = (uint16_t)(VRING_DESC_F_NEXT | (write ? 0 : VRING_DESC_F_WRITE));
+		desc[1].next = 2;
+
+		desc[2].addr = sv.dma_pa + DMA_BLK_STATUS;
+		desc[2].len = 1;
+		desc[2].flags = VRING_DESC_F_WRITE;
+		desc[2].next = 0;
+	} else {
+		desc[1].addr = sv.dma_pa + DMA_BLK_STATUS;
+		desc[1].len = 1;
+		desc[1].flags = VRING_DESC_F_WRITE;
+		desc[1].next = 0;
+	}
+
+	uint16_t idx = avail->idx;
+	avail->ring[idx % sv.blk_qsize] = 0;
+	dma_sync(DMA_BLK_VRING, 0x2020);
+	if (len > 0) {
+		dma_sync(DMA_BOUNCE, len);
+	}
+	__builtin_arm_dsb(0xf);
+	avail->idx = (uint16_t)(idx + 1);
+	dma_sync(DMA_BLK_VRING, 0x1000);
+	__builtin_arm_dsb(0xf);
+
+	mmio_wr(sv.blk_regs, VIRTIO_MMIO_QUEUE_NOTIFY, 0);
+
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	while (used->idx == sv.blk_last_used) {
+		dma_sync(DMA_BLK_USED, sizeof(struct vring_used));
+		if (used->idx != sv.blk_last_used) {
+			break;
+		}
+		if (mach_absolute_time() > deadline) {
+			printf("SWEET VIRTIO: blk cmd %u sector 0x%llx timed out\n", type, sector);
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	sv.blk_last_used = used->idx;
+	uint32_t isr = mmio_rd(sv.blk_regs, VIRTIO_MMIO_INTERRUPT_STATUS);
+	if (isr) {
+		mmio_wr(sv.blk_regs, VIRTIO_MMIO_INTERRUPT_ACK, isr);
+	}
+	dma_sync(DMA_BLK_REQ, 32);
+	if (len > 0 && !write) {
+		dma_sync(DMA_BOUNCE, len);
+	}
+	if (*status != VIRTIO_BLK_S_OK) {
+		printf("SWEET VIRTIO: blk cmd %u sector 0x%llx failed: status 0x%x\n",
+		    type, sector, *status);
+		return EIO;
+	}
+	return 0;
+}
+
+static int
+virtio_rw_sectors(uint64_t sector, uint32_t nsecs, bool write)
+{
+	if (nsecs == 0 || nsecs > BOUNCE_SIZE / VIRTIO_SECTOR) {
+		return EINVAL;
+	}
+	if (write && (!sv.writable || sector < sv.first_sec ||
+	    sector - sv.first_sec >= sv.nsecs ||
+	    nsecs > sv.nsecs - (sector - sv.first_sec))) {
+		printf("SWEET VIRTIO: refusing write of %u sectors at 0x%llx\n", nsecs, sector);
+		return EPERM;
+	}
+	return virtio_blk_cmd(write ? VIRTIO_BLK_T_OUT : VIRTIO_BLK_T_IN,
+	    sector, nsecs * VIRTIO_SECTOR, write);
+}
+
+static int
+virtio_find_volume(const char *want)
+{
+	const uint8_t *b = (const uint8_t *)(sv.dma + DMA_BOUNCE);
+	if (sv.capacity_secs < 16) {
+		return ENXIO;
+	}
+	int error = virtio_rw_sectors(0, 16, false);
+	if (error) {
+		return error;
+	}
+	/* Raw HFS+ / HFSX volume header at byte offset 1024 of LBA 0 ("HX" or "H+"). */
+	if (b[1024] == 'H' && (b[1025] == 'X' || b[1025] == '+')) {
+		sv.first_sec = 0;
+		sv.nsecs = sv.capacity_secs;
+		printf("SWEET VIRTIO: raw HFS+ volume on whole disk (%llu MiB)\n",
+		    (sv.nsecs * VIRTIO_SECTOR) >> 20);
+		return 0;
+	}
+
+	uint32_t gpt_lba_size = 0;
+	if (memcmp(b + 512, "EFI PART", 8) == 0) {
+		gpt_lba_size = 512;
+	} else if (memcmp(b + 4096, "EFI PART", 8) == 0) {
+		gpt_lba_size = 4096;
+	}
+	if (gpt_lba_size == 0) {
+		sv.first_sec = 0;
+		sv.nsecs = sv.capacity_secs;
+		printf("SWEET VIRTIO: no GPT found, using whole disk (%llu MiB)\n",
+		    (sv.nsecs * VIRTIO_SECTOR) >> 20);
+		return 0;
+	}
+
+	const uint8_t *gh = b + gpt_lba_size;
+	uint64_t entry_lba;
+	uint32_t nent, esz;
+	memcpy(&entry_lba, gh + 72, 8);
+	memcpy(&nent, gh + 80, 4);
+	memcpy(&esz, gh + 84, 4);
+	if (esz != 128 || nent == 0 || nent * esz > BOUNCE_SIZE) {
+		printf("SWEET VIRTIO: unsupported GPT entries %u x %u\n", nent, esz);
+		return ENXIO;
+	}
+	uint32_t spb = gpt_lba_size / VIRTIO_SECTOR;
+	uint32_t entry_secs = (nent * esz + VIRTIO_SECTOR - 1) / VIRTIO_SECTOR;
+	error = virtio_rw_sectors(entry_lba * spb, entry_secs, false);
+	if (error) {
+		return error;
+	}
+
+	uint64_t fallback_first = 0, fallback_last = 0;
+	for (uint32_t i = 0; i < nent; i++) {
+		const uint8_t *e = b + i * esz;
+		uint64_t first, last;
+		memcpy(&first, e + 32, 8);
+		memcpy(&last, e + 40, 8);
+		if (first == 0 || last < first) {
+			continue;
+		}
+		if (fallback_first == 0) {
+			fallback_first = first;
+			fallback_last = last;
+		}
+		char name[37];
+		unsigned c;
+		for (c = 0; c < 36; c++) {
+			uint16_t ch = (uint16_t)(e[56 + 2 * c] | (e[57 + 2 * c] << 8));
+			if (ch == 0 || ch > 0x7f) {
+				break;
+			}
+			name[c] = (char)ch;
+		}
+		name[c] = 0;
+		if (strcmp(name, want) == 0) {
+			sv.first_sec = first * spb;
+			sv.nsecs = (last - first + 1) * spb;
+			return 0;
+		}
+	}
+	if (fallback_first != 0) {
+		sv.first_sec = fallback_first * spb;
+		sv.nsecs = (fallback_last - fallback_first + 1) * spb;
+		printf("SWEET VIRTIO: partition \"%s\" not found, using first GPT partition\n", want);
+		return 0;
+	}
+	return ENOENT;
+}
+
+static int
+sweet_virtio_open(__unused dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
+{
+	if (!sv.ready) {
+		return ENXIO;
+	}
+	return ((flags & FWRITE) && !sv.writable) ? EROFS : 0;
+}
+
+static int
+sweet_virtio_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static void
+sweet_virtio_strategy(buf_t bp)
+{
+	int error = 0;
+	caddr_t vaddr = NULL;
+	uint64_t off = (uint64_t)buf_blkno(bp) * sv.secsize;
+	uint32_t count = buf_count(bp);
+	uint64_t part_bytes = sv.nsecs * VIRTIO_SECTOR;
+	bool rd = (buf_flags(bp) & B_READ) != 0;
+
+	buf_setresid(bp, count);
+	if (!rd && !sv.writable) {
+		error = EROFS;
+		goto done;
+	}
+	if (off > part_bytes || count > part_bytes - off) {
+		error = EINVAL;
+		goto done;
+	}
+	if (count == 0) {
+		goto done;
+	}
+	if (buf_map(bp, &vaddr)) {
+		error = EIO;
+		goto done;
+	}
+
+	lck_mtx_lock(&sweet_virtio_lock);
+	for (uint32_t done = 0; done < count;) {
+		uint64_t pos = off + done;
+		uint64_t sec = pos / VIRTIO_SECTOR;
+		uint32_t skip = (uint32_t)(pos % VIRTIO_SECTOR);
+		uint32_t want = MIN(count - done, BOUNCE_SIZE - skip);
+		uint32_t nsecs = (skip + want + VIRTIO_SECTOR - 1) / VIRTIO_SECTOR;
+		void *bounce = (void *)(sv.dma + DMA_BOUNCE);
+		if (rd) {
+			error = virtio_rw_sectors(sv.first_sec + sec, nsecs, false);
+			if (!error) {
+				memcpy(vaddr + done, (const char *)bounce + skip, want);
+			}
+		} else {
+			if (skip || (want % VIRTIO_SECTOR)) {
+				error = virtio_rw_sectors(sv.first_sec + sec, nsecs, false);
+			}
+			if (!error) {
+				memcpy((char *)bounce + skip, vaddr + done, want);
+				error = virtio_rw_sectors(sv.first_sec + sec, nsecs, true);
+			}
+		}
+		if (error) {
+			break;
+		}
+		done += want;
+		buf_setresid(bp, count - done);
+	}
+	lck_mtx_unlock(&sweet_virtio_lock);
+	buf_unmap(bp);
+
+done:
+	if (error) {
+		buf_seterror(bp, error);
+	}
+	buf_biodone(bp);
+}
+
+static int
+sweet_virtio_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag,
+    __unused struct proc *p, int is_char)
+{
+	uint32_t *f = (uint32_t *)data;
+	uint64_t *o = (uint64_t *)data;
+
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*f = sv.secsize;
+		return 0;
+	case DKIOCSETBLOCKSIZE:
+		if (is_char) {
+			return ENODEV;
+		}
+		if (*f < DEV_BSIZE || *f > VIRTIO_PHYS_BLOCK || (*f & (*f - 1))) {
+			return EINVAL;
+		}
+		sv.secsize = *f;
+		return 0;
+	case DKIOCGETPHYSICALBLOCKSIZE:
+		*f = VIRTIO_PHYS_BLOCK;
+		return 0;
+	case DKIOCGETBLOCKCOUNT:
+		*o = (sv.nsecs * VIRTIO_SECTOR) / sv.secsize;
+		return 0;
+	case DKIOCISWRITABLE:
+		*f = sv.writable ? 1 : 0;
+		return 0;
+	case DKIOCSYNCHRONIZE:
+	case DKIOCSYNCHRONIZECACHE:
+		if (!sv.writable) {
+			return 0;
+		}
+		lck_mtx_lock(&sweet_virtio_lock);
+		(void)virtio_blk_cmd(VIRTIO_BLK_T_FLUSH, 0, 0, false);
+		lck_mtx_unlock(&sweet_virtio_lock);
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTREAD:
+		*o = BOUNCE_SIZE / sv.secsize;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTWRITE:
+		*o = sv.writable ? (BOUNCE_SIZE / sv.secsize) : 0;
+		return 0;
+	case DKIOCGETMAXSEGMENTCOUNTREAD:
+	case DKIOCGETMAXSEGMENTCOUNTWRITE:
+		*o = 1;
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+sweet_virtio_bioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return sweet_virtio_ioctl(dev, cmd, data, flag, p, 0);
+}
+
+static int
+sweet_virtio_cioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return sweet_virtio_ioctl(dev, cmd, data, flag, p, 1);
+}
+
+static int
+sweet_virtio_psize(__unused dev_t dev)
+{
+	return sv.ready ? (int)MIN((sv.nsecs * VIRTIO_SECTOR) / sv.secsize, (uint64_t)INT_MAX) : -1;
+}
+
+static int
+sweet_virtio_read(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return physio(sweet_virtio_strategy, NULL, dev, B_READ, minphys, uio, (int)sv.secsize);
+}
+
+static int
+sweet_virtio_write(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	if (!sv.writable) {
+		return EROFS;
+	}
+	return physio(sweet_virtio_strategy, NULL, dev, B_WRITE, minphys, uio, (int)sv.secsize);
+}
